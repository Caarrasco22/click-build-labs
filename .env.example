# Copy to .env.local, or set build-time variables in Cloudflare Pages.
# Your real public ID is centralized in lib/adsense.mjs; no override is needed.
# To disable even verification, uncomment the empty override below.
# ADSENSE_PUBLISHER_ID=
# Verification works with the ID alone. Keep both flags false for review.
ADSENSE_ENABLED=false
# Set true only after publishing and checking Google's European regulations message.
ADSENSE_CMP_READY=false
